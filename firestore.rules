rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own top-level user document
    // (stores plan, subscription status, etc.)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // All nested subcollections (dashboardData, config, etc.)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
